# .env.example — template only. NEVER put real secrets in this file.
# Copy to .env (gitignored) and fill in.

# ── Environment selection (Milestone 0 safety harness) ──────────────────────
# Strictly "development" or "production". Any other value throws on startup.
# Unset behaves as production, which is what the live scheduler relies on.
# KEN_ENV=development

# ── Spreadsheet ids ─────────────────────────────────────────────────────────
# Unset => the production spreadsheets (current behaviour).
# When KEN_ENV=development BOTH of these are mandatory and must not be a
# production id; the process refuses to start otherwise.
# MAIN_SHEET_ID=your_development_spreadsheet_id
# DISTRIBUTED_URL_SHEET_ID=your_development_spreadsheet_id

# Tab-scoped testing: when the test tab lives INSIDE the production
# spreadsheet, set MAIN_SHEET_ID to the production id AND name the tab here.
# Every read and write is then confined to that one tab, and structural
# changes (add/delete/rename a tab) are blocked outright.
# Without this, development mode refuses to start on a production id.
# KEN_DEV_SHEET_TAB=Test_Abhinav
#
# Tabs this run may create and use. Any tab starting with this prefix is ours;
# every pre-existing live tab fails the check and cannot be created, written,
# renamed or deleted.
# KEN_DEV_TAB_PREFIX=Test_

# Optional: relocate the development sandbox (default ./dev-sandbox)
# KEN_DEV_SANDBOX=D:/ken-dev-sandbox

# ── Credentials (examples only — real values belong in .env) ────────────────
# GOOGLE_SERVICE_ACCOUNT_JSON=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY_1=
# NVIDIA_API_KEY_1=
# TAVILY_API_KEY_1=
# SERPAPI_KEY_1=
# X_USERNAME=
# X_PASSWORD=
# X_HANDLE=
