{
  "name": "x-posting-agent",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --import=tsx src/index.ts",
    "dev:supervised": "node --import=tsx src/supervisor.ts",
    "ledger:seed": "node --import=tsx src/tools/ledgerSeed.ts",
    "ledger": "node --import=tsx -e \"import('./src/batchLedger.ts').then(m=>console.log(JSON.stringify(m.ledgerSummary(),null,2)))\"",
    "once": "node --import=tsx src/index.ts once",
    "schedule": "node --import=tsx src/index.ts schedule",
    "blog": "node --import=tsx src/blogRunner.ts",
    "accounts": "node --import=tsx src/config/accounts.ts",
    "accounts:add": "node --import=tsx src/config/accounts.ts add",
    "accounts:list": "node --import=tsx src/config/accounts.ts list",
    "login": "node --import=tsx src/login-account.ts",
    "login:x": "node --import=tsx src/tools/loginX.ts",
    "login:x:all": "node --import=tsx src/tools/loginXAll.ts",
    "login:x:manual": "node --import=tsx src/tools/loginXInteractive.ts",
    "fb-post": "node --import=tsx src/index.ts fb-post",
    "linkedin-post": "node --import=tsx src/index.ts linkedin-post",
    "tracker": "node --import=tsx src/index.ts tracker",
    "hackmd-keys": "node --import=tsx src/tools/hackmdGetApiKeys.ts",
    "generate:fb": "node --import=tsx src/tools/generateSocialPosts.ts fb",
    "generate:li": "node --import=tsx src/tools/generateSocialPosts.ts li",
    "generate:fb-li": "node --import=tsx src/tools/generateFbLiPosts.ts",
    "login:chatgpt": "node --import=tsx src/tools/loginChatGpt.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@browserbasehq/stagehand": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "dotenv": "^16.0.0",
    "googleapis": "^144.0.0",
    "node-cron": "^4.2.1",
    "playwright": "^1.44.0",
    "pptxgenjs": "^4.0.1",
    "turndown": "^7.2.4",
    "twitter-api-v2": "^1.29.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
